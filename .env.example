# --- Supabase -----------------------------------------------------------------
# Project Settings > API. These two are safe to ship to the browser, which is why
# they carry the NEXT_PUBLIC_ prefix. Access is gated by Row Level Security, not by
# hiding the key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API > service_role. SERVER ONLY. It bypasses Row Level Security,
# so anything holding it can read and write every table, including rows belonging to
# other users. Never prefix it with NEXT_PUBLIC_, never import it from a component,
# and never commit it. Used by `bun run seed`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Model provider -----------------------------------------------------------
# Only the Explain and check-my-answer buttons call this, and only for a wording the
# sentence bank has not seen. From https://console.groq.com/keys, server side only.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-20b.
GROQ_MODEL=
